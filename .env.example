# Copy to .env and fill in. Never commit .env.

# LLM (any OpenAI-compatible endpoint). Free Groq key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Ollama alternative (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# App under test (TestMu Lite)
TEST_MODE=1
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
SESSION_TTL_SECONDS=1800
RATE_LIMIT_PER_MIN=60
