  "cases": [
    {
      "id": "API-001",
      "module": "api",
      "title": "Valid admin token allows access to test case list",
      "coverage_area": "auth token validation",
      "type": "positive",
      "priority": "P0",
      "preconditions": [
        "Reset system state",
        "Obtain admin token via POST /api/v1/auth/token with valid credentials"
      ],
      "test_data": {
        "email": "admin@testmu.local",
        "password": "{{admin_password}}"
      },
      "steps": [
        "POST /api/v1/auth/token with email and password",
        "Extract access_token from response",
        "GET /api/v1/test-cases with Authorization: Bearer <token>"
      ],
      "expected_results": [
        "POST returns 200 with access_token field",
        "GET returns 200 and a JSON body containing items array",
        "Response includes field \"page\" as integer",
        "No error object present"
      ],
      "automation_candidate": true,
      "notes": ""
    },
    {
